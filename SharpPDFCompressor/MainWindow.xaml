<?xml version="1.0" encoding="utf-8"?>

<winex:WindowEx
    x:Class="SharpPDFCompressor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    MinWidth="1250"
    MinHeight="600"
    mc:Ignorable="d"
    Title="SharpPDFCompressor">
    <winex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winex:WindowEx.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar
            Padding="15"
            x:Name="AppTitleBar"
            Title="SharpPDFCompressor"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Row="1" Padding="1">
            <NavigationView
                x:Name="MainNavigationView"
                PaneDisplayMode="LeftCompact"
                IsBackButtonVisible="Collapsed"
                SelectionChanged="SideMenu_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        x:Uid="HomePageButton"
                        Icon="Home"
                        x:Name="HomePageSideButton" />
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem
                        x:Name="ThemeToggleSideButton"
                        Content="Theme"
                        SelectsOnInvoked="False"
                        PointerPressed="ThemeToggle_PointerPressed">
                        <NavigationViewItem.Icon>
                            <FontIcon x:Name="ThemeIcon" Glyph="&#xE7F4;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
                <Frame x:Name="ContentFrame" />
            </NavigationView>
        </Grid>
    </Grid>
</winex:WindowEx>