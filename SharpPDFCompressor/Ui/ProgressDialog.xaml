<ContentDialog
    x:Class="SharpPDFCompressor.Ui.ProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}">

    <Grid RowSpacing="16" MinWidth="350" MaxWidth="450">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MaxHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.CurrentFileBeingCompressed, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

        <TextBlock Grid.Row="1"
                   Text="{x:Bind ViewModel.ProgressSummary, Mode=OneWay}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ProgressBar Grid.Row="2"
                     HorizontalAlignment="Stretch"
                     MinHeight="4"
                     Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                     ShowError="{x:Bind ViewModel.ShowError, Mode=OneWay}" />

        <InfoBar Grid.Row="3"
                 x:Uid="SizeSummaryInfoBar"
                 IsOpen="True"
                 Severity="Informational"
                 IsClosable="False"
                 IsIconVisible="True"
                 Margin="0,0,0,8"
                 Visibility="{x:Bind ViewModel.SizeSummaryVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <InfoBar.Content>
                <Grid ColumnSpacing="16" Margin="0,0,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Before Size -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8B9;"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock x:Uid="SizeBeforeLabel"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.BeforeSize, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Arrow -->
                        <FontIcon Grid.Column="1"
                                  Glyph="&#xE76C;"
                                  FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,0,4" />

                        <!-- After Size -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8B9;"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock x:Uid="SizeAfterLabel"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.AfterSize, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Reduction Badge -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left">
                        <TextBlock x:Uid="SizeReducedByLabel"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.ReductionSize, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ReductionPercentText, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </InfoBar.Content>
        </InfoBar>

        <ScrollView Grid.Row="4"
                    MaxHeight="200"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind ViewModel.WorkerFileStatusesVisibility, Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.WorkerFileStatuses}" Margin="4,0,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE8D5;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollView>

        <Grid Grid.Row="5"
              Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}"
              RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Errors encountered"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

            <ListView Grid.Row="1"
                      x:Name="DialogErrorList"
                      Height="180"
                      HorizontalAlignment="Stretch"
                      CornerRadius="4"
                      Background="{ThemeResource LayerFillColorAltBrush}"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      SelectionMode="Single"
                      SelectedItem="{x:Bind ViewModel.SelectedListError, Mode=TwoWay}"
                      SelectionChanged="{x:Bind ViewModel.CopyErrorToClipboard}"
                      ItemsSource="{x:Bind ViewModel.ErrorList, Mode=OneWay}">

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}"
                                   TextWrapping="Wrap"
                                   Margin="0,8"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </DataTemplate>
                </ListView.ItemTemplate>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="4,2" />
                        <Setter Property="CornerRadius" Value="4" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <TeachingTip Grid.Row="0" x:Uid="CopiedErrorTeachingTip"
                     Target="{x:Bind DialogErrorList}"
                     PreferredPlacement="Top"
                     IsLightDismissEnabled="True"
                     IsOpen="{x:Bind ViewModel.TipShown, Mode=OneWay}">
            <TeachingTip.IconSource>
                <SymbolIconSource Symbol="Copy" />
            </TeachingTip.IconSource>
        </TeachingTip>

    </Grid>
</ContentDialog>