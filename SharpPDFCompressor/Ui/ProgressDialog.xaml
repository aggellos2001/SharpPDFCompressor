<ContentDialog
    x:Class="SharpPDFCompressor.Ui.ProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12" MinWidth="350" MaxWidth="350">
        <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.FileText,Mode=OneWay}"></TextBlock>
        <ProgressBar Margin="0 5" MinHeight="10"
                     Width="300"
                     Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                     ShowError="{x:Bind ViewModel.ShowError,Mode=OneWay}" />
        <ListView
            x:Name="DialogErrorList"
            Visibility="{x:Bind ViewModel.ShowError,Mode=OneWay}"
            Margin="0 10"
            BorderThickness="1"
            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
            Width="350"
            Height="200"
            SelectionMode="Single"
            HorizontalAlignment="Left"
            SelectedItem="{x:Bind ViewModel.SelectedListError, Mode=TwoWay}"
            SelectionChanged="{x:Bind ViewModel.CopyErrorToClipboard}"
            ItemsSource="{x:Bind ViewModel.ErrorList, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Grid Width="320" Padding="0,4" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>


        <TeachingTip
            x:Uid="CopiedErrorTeachingTip"
            Target="{x:Bind DialogErrorList}"
            PreferredPlacement="Top"
            IsLightDismissEnabled="True"
            IsOpen="{x:Bind ViewModel.TipShown, Mode=OneWay}">
            <TeachingTip.IconSource>
                <SymbolIconSource Symbol="Copy" />
            </TeachingTip.IconSource>
        </TeachingTip>
    </StackPanel>
</ContentDialog>