<Page
    x:Class="SharpPDFCompressor.Ui.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:localizer="using:WinUI3Localizer"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  AllowDrop="True"
                  DragOver="{x:Bind ViewModel.OnDragOver}"
                  Drop="{x:Bind  ViewModel.OnDrop}">

        <Grid Padding="30" HorizontalAlignment="Stretch" RowSpacing="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" localizer:Uids.Uid="HomeTitle" FontSize="26" />
            <TextBlock Grid.Row="1" localizer:Uids.Uid="HomeSubTitle" />

            <Grid Grid.Row="2" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         localizer:Uids.Uid="FilePathTextBox"
                         MinHeight="50"
                         MaxHeight="100"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Margin="0,0,10,0"
                         HorizontalAlignment="Stretch"
                         Text="{x:Bind ViewModel.FilePath, Mode=OneWay}" />

                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.SelectFileCommand}"
                        CommandParameter="false"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip=".pdf or .zip"
                        MinHeight="50"
                        Margin="0,0,10,0"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xe8e5;" Margin="0,0,8,0" />
                        <TextBlock localizer:Uids.Uid="PickFileButton" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Command="{x:Bind ViewModel.SelectFileCommand}"
                        CommandParameter="true"
                        Style="{StaticResource AccentButtonStyle}"
                        MinHeight="50"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xed25;" Margin="0,0,8,0" />
                        <TextBlock localizer:Uids.Uid="PickFolderButton" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Grid.Row="4" Spacing="5" HorizontalAlignment="Stretch">
                <controls:SettingsCard localizer:Uids.Uid="CompressImages"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE8B9;}"
                                       HorizontalAlignment="Stretch">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.CompressImages, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="{x:Bind ViewModel.DeleteOriginalCardHeader,Mode=OneWay}"
                                       Description="{x:Bind ViewModel.DeleteOriginalCardDescription,Mode=OneWay}"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE107;}"
                                       HorizontalAlignment="Stretch"
                                       IsEnabled="{x:Bind ViewModel.EnabledDeleteOriginalFilesButton,Mode=OneWay}">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.DeleteOriginalFiles, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsExpander localizer:Uids.Uid="AdvancedSettingsExpander"
                                           HeaderIcon="{ui:FontIcon Glyph=&#xE713;}"
                                           HorizontalAlignment="Stretch">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard localizer:Uids.Uid="IgnoreCompressedFilesCard"
                                               HeaderIcon="{ui:FontIcon Glyph=&#xEB9D;}"
                                               HorizontalAlignment="Stretch">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IgnoreCompressedFiles, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard localizer:Uids.Uid="CompressedSuffixCard"
                                               HeaderIcon="{ui:FontIcon Glyph=&#xE70F;}"
                                               HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBox Text="{x:Bind ViewModel.CompressedSuffix, Mode=TwoWay}" MinWidth="160" />
                                <Button Click="ResetCompressedSuffix_Click"
                                        ToolTipService.ToolTip="Reset to default"
                                        AutomationProperties.Name="Reset compressed file suffix">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE777;" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard localizer:Uids.Uid="ParallelismLevel"
                                               HeaderIcon="{ui:FontIcon Glyph=&#xEC4A;}"
                                               HorizontalAlignment="Stretch">
                            <ComboBox SelectedValue="{x:Bind ViewModel.ParallelismLevel,Mode=TwoWay}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="4" />
                                <ComboBoxItem Content="8" />
                                <ComboBoxItem Content="16" />
                                <ComboBoxItem Content="32" />
                            </ComboBox>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>

            <Button Grid.Row="5" localizer:Uids.Uid="CompressButton" HorizontalAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.CompressionButtonEnabled, Mode=OneWay}"
                    Command="{x:Bind ViewModel.CompressCommand}"
                    CommandParameter="{x:Bind XamlRoot}"
                    FontSize="16"
                    MinHeight="60"
                    MinWidth="300"
                    Margin="0 15"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Margin="00 0 10 0" FontFamily="Segoe Fluent Icons" Glyph="&#xf012;" />
                    <TextBlock localizer:Uids.Uid="InnerCompressButton" />
                </StackPanel>
            </Button>

        </Grid>
    </ScrollViewer>
</Page>