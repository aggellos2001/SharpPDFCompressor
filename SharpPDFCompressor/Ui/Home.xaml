<Page
    x:Class="SharpPDFCompressor.Ui.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  AllowDrop="True"
                  DragOver="{x:Bind ViewModel.OnDragOver}"
                  Drop="{x:Bind  ViewModel.OnDrop}">

        <Grid Padding="30" HorizontalAlignment="Stretch" RowSpacing="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Uid="HomeTitle" FontSize="26"/>
            <TextBlock Grid.Row="1" x:Uid="HomeSubTitle"/>

            <Grid Grid.Row="2" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                         x:Uid="FilePathTextBox"
                         MinHeight="50"
                         MaxHeight="100"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Margin="0,0,10,0"
                         HorizontalAlignment="Stretch"
                         Text="{x:Bind ViewModel.FilePath, Mode=OneWay}" />

                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.SelectFileCommand}"
                        CommandParameter="false"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip=".pdf or .zip"
                        MinHeight="50"
                        Margin="0,0,10,0"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xe8e5;" Margin="0,0,8,0" />
                        <TextBlock x:Uid="PickFileButton" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Command="{x:Bind ViewModel.SelectFileCommand}"
                        CommandParameter="true"
                        Style="{StaticResource AccentButtonStyle}"
                        MinHeight="50"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xed25;" Margin="0,0,8,0" />
                        <TextBlock x:Uid="PickFolderButton" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Grid.Row="3" Spacing="10" HorizontalAlignment="Stretch">
                <controls:SettingsCard x:Uid="CompressionLevelGroup"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xe73f;}"
                                       HorizontalAlignment="Stretch">
                    <ComboBox SelectedValue="{x:Bind ViewModel.CompressionLevel,Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Tag="prepress" x:Uid="LowCompressionButton"></ComboBoxItem>
                        <ComboBoxItem Tag="printer" x:Uid="MediumCompressionButton"></ComboBoxItem>
                        <ComboBoxItem Tag="ebook" x:Uid="HighCompressionButton"></ComboBoxItem>
                        <ComboBoxItem Tag="screen" x:Uid="MaxCompressionButton"></ComboBoxItem>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="ParallelismLevel"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xe73f;}"
                                       HorizontalAlignment="Stretch">
                    <ComboBox SelectedValue="{x:Bind ViewModel.ParallelismLevel,Mode=TwoWay}" SelectedValuePath="Content">
                        <ComboBoxItem Content="1"></ComboBoxItem>
                        <ComboBoxItem Content="2"></ComboBoxItem>
                        <ComboBoxItem Content="4"></ComboBoxItem>
                        <ComboBoxItem Content="8"></ComboBoxItem>
                        <ComboBoxItem Content="16"></ComboBoxItem>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="DeleteOriginalFilesSwitch"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE107;}"
                                       HorizontalAlignment="Stretch">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.DeleteOriginalFiles, Mode=TwoWay}" />
                </controls:SettingsCard>
            </StackPanel>

            <Button Grid.Row="4" x:Uid="CompressButton" HorizontalAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.CompressionButtonEnabled, Mode=OneWay}"
                    Command="{x:Bind ViewModel.CompressCommand}"
                    CommandParameter="{x:Bind XamlRoot}"
                    FontSize="16"
                    MinHeight="60"
                    MinWidth="300"
                    Margin="0 15"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Margin="00 0 10 0" FontFamily="Segoe Fluent Icons" Glyph="&#xf012;"/>
                    <TextBlock x:Uid="InnerCompressButton" />
                </StackPanel>
            </Button>

        </Grid>
    </ScrollViewer>
</Page>