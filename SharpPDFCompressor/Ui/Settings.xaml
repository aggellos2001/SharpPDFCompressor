<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="SharpPDFCompressor.Ui.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SharpPDFCompressor.DataModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:localizer="using:WinUI3Localizer"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="20 0 20 40" HorizontalAlignment="Stretch" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid HorizontalAlignment="Stretch" Padding="0 20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock localizer:Uids.Uid="SettingsTitle"
                           FontSize="26"
                           Grid.Column="0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.AppVersion}"
                           Grid.Column="2"
                           VerticalAlignment="Center" />
            </Grid>
            <controls:SettingsCard Grid.Row="1" localizer:Uids.Uid="ThemeSettingsCard">
                <ComboBox x:Name="ThemeComboBox"
                          SelectedIndex="0"
                          SelectionChanged="ThemeSelection_SelectionChanged">
                    <ComboBoxItem localizer:Uids.Uid="ThemeSystemOption" Content="Use system setting" />
                    <ComboBoxItem localizer:Uids.Uid="ThemeLightOption" Content="Light" />
                    <ComboBoxItem localizer:Uids.Uid="ThemeDarkOption" Content="Dark" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Grid.Row="2" localizer:Uids.Uid="LanguageSettingsCard">
                <ComboBox x:Name="LanguageComboBox"
                          SelectedIndex="0"
                          SelectionChanged="LanguageSelection_SelectionChanged">
                    <ComboBoxItem localizer:Uids.Uid="LanguageSystemOption" Content="Use Windows language" />
                    <ComboBoxItem localizer:Uids.Uid="LanguageEnglishOption" Content="English" />
                    <ComboBoxItem localizer:Uids.Uid="LanguageGreekOption" Content="Greek" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Grid.Row="3" localizer:Uids.Uid="AppDataSettingsCard">
                <Button Click="AppDataFolderButton_Click"
                        localizer:Uids.Uid="OpenAppDataFolderButton">
                    <TextBlock localizer:Uids.Uid="OpenAppDataFolderButtonText" />
                </Button>
            </controls:SettingsCard>

            <controls:SettingsCard Grid.Row="4" localizer:Uids.Uid="GithubButton">
                <Button Click="GitHubButtonOpenLink">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16" VerticalAlignment="Center">
                            <Image.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/GitHub_Invertocat_Black.svg" />
                            </Image.Source>
                        </Image>
                        <TextBlock localizer:Uids.Uid="GithubLinkButton" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </controls:SettingsCard>

            <controls:SettingsCard Grid.Row="5" localizer:Uids.Uid="LogoAttribution">
                <Button Click="LogoLinkedInOpenLink">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="ms-appx:///Assets/LI-In-Bug.png"
                               Width="16"
                               Height="16"
                               VerticalAlignment="Center" />
                        <TextBlock localizer:Uids.Uid="LinkedInLinkButton" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </controls:SettingsCard>

            <controls:SettingsExpander Grid.Row="6" localizer:Uids.Uid="LicenseExpander"
                                       HorizontalAlignment="Stretch"
                                       ItemsSource="{x:Bind ViewModel.Licenses, Mode=OneWay}">
                <controls:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="local:PackageLicense">
                        <controls:SettingsCard Header="{x:Bind PackageId}"
                                               Description="{x:Bind VersionWithLicense}"
                                               Tag="{x:Bind}"
                                               IsClickEnabled="True"
                                               Click="LicenseCard_Click" />
                    </DataTemplate>
                </controls:SettingsExpander.ItemTemplate>
            </controls:SettingsExpander>

            <controls:SettingsCard x:Name="UpdateCheckCard"
                                   Grid.Row="7"
                                   localizer:Uids.Uid="UpdateCheckCard">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="UpdateProgressRing"
                                  IsActive="{x:Bind ViewModel.UpdateInProgress, Mode=OneWay}"
                                  Width="16"
                                  Height="16"
                                  Visibility="Collapsed" />
                    <Button x:Name="CheckForUpdatesButton"
                            Click="CheckForUpdatesButton_Click">
                        <TextBlock localizer:Uids.Uid="CheckForUpdatesButtonText" />
                    </Button>
                </StackPanel>
            </controls:SettingsCard>
        </Grid>
    </ScrollViewer>
</Page>