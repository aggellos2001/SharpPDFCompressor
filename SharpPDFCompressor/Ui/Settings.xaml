<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="SharpPDFCompressor.Ui.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SharpPDFCompressor.DataModels"
    xmlns:winUi="using:CommunityToolkit.WinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="20 0" HorizontalAlignment="Stretch" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid HorizontalAlignment="Stretch" Padding="0 20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="SettingsTitle"
                           FontSize="26"
                           Grid.Column="0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.AppVersion}"
                           Grid.Column="2"
                           VerticalAlignment="Center" />
            </Grid>
            <controls:SettingsCard Grid.Row="1" x:Uid="GithubButton">
                <Button Click="GitHubButtonOpenLink">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16" VerticalAlignment="Center">
                            <Image.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/GitHub_Invertocat_Black.svg"/>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="View on GitHub" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </controls:SettingsCard>

            <controls:SettingsCard Grid.Row="2" x:Uid="LogoAttribution">
                <Button Click="LogoLinkedInOpenLink">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="ms-appx:///Assets/LI-In-Bug.png" 
                               Width="16"
                               Height="16" 
                               VerticalAlignment="Center"/>
                        <TextBlock Text="View on LinkedIn" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </controls:SettingsCard>

            <Expander Grid.Row="3" x:Uid="LicenseExpander"
                      HorizontalAlignment="Stretch"
                      ExpandDirection="Down">
                <ListView ItemsSource="{x:Bind ViewModel.Licenses,Mode=OneWay}" SelectionMode="None" Width="750">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PackageLicense">
                            <Grid Padding="0,12,0,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind PackageId}" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="{x:Bind PackageVersion}" Foreground="Gray"
                                                   VerticalAlignment="Bottom" />
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind DisplayLicense}" FontStyle="Italic" Foreground="Gray" />
                                </StackPanel>
                                <HyperlinkButton Grid.Column="1"
                                                 NavigateUri="{x:Bind ActionableUrl}"
                                                 Content="View License"
                                                 VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Expander>
        </Grid>
    </ScrollViewer>
</Page>